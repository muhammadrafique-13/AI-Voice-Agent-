# ---------------------------------------------------------------------------
# Copy to .env for local development. NEVER commit the real .env.
# In production these are set in the Vercel project's Environment Variables.
# ---------------------------------------------------------------------------

# Postgres connection string. Vercel's Neon integration injects this automatically.
# Leave unset locally to fall back to a SQLite file at ./patients.db
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Shared secret Vapi sends as the X-Vapi-Secret header on every webhook request.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, webhook verification is skipped (acceptable locally, not in production).
VAPI_SERVER_SECRET=

# development | production
APP_ENV=development

LOG_LEVEL=INFO

# Browser calling page at /call (optional). Both are safe to expose in a public page:
# the *public* key is a client-side credential and an assistant id is not a secret.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
PUBLIC_PHONE_NUMBER=
